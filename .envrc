#!/usr/bin/env bash

# Source ROS Humble
if [[ -f /opt/ros/humble/setup.bash ]]; then
    source /opt/ros/humble/setup.bash
else
    echo "Warning: /opt/ros/humble/setup.bash not found"
fi

# Source the selected Autoware (AUTOWARE_VERSION, then the golf-cart
# superproject's selection, then 1.5.0; see scripts/autoware_version.sh)
watch_file scripts/autoware_version.sh
source scripts/activate_autoware.sh

# Source this version's workspace overlay
if [[ -f "$CUDA_NDT_INSTALL_DIR/setup.bash" ]]; then
    watch_file "$CUDA_NDT_INSTALL_DIR/setup.bash"
    source "$CUDA_NDT_INSTALL_DIR/setup.bash"
fi

# Use Cyclone DDS
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
