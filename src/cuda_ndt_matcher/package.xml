<package format="3">
  <name>cuda_ndt_matcher</name>
  <version>0.1.0</version>
  <description>CUDA-accelerated NDT scan matcher for localization</description>
  <maintainer email="jerry73204@gmail.com">Hsiang-Jui Lin</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tier4_localization_msgs</depend>
  <depend>autoware_internal_localization_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>autoware_internal_debug_msgs</depend>
  <depend>autoware_map_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <!--
    Not used by this package. rclrs 0.7.0 vendors bindings for test_msgs
    (rclrs-0.7.0/src/vendor/test_msgs/) and links them unconditionally, so the
    package fails to link without it:

      rust-lld: error: unable to find library -ltest_msgs__rosidl_typesupport_c

    Declared here so rosdep installs it. Remove only when rclrs stops linking
    it, not because it looks unused.
  -->
  <depend>test_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
