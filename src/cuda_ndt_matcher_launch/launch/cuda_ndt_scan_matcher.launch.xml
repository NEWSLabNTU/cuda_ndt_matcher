<?xml version="1.0"?>
<launch>
  <!-- CUDA NDT Scan Matcher Launch
       Drop-in replacement for autoware_ndt_scan_matcher/launch/ndt_scan_matcher.launch.xml
       Uses the same interface (topics, params, remappings)
  -->

  <arg name="param_file" default="$(find-pkg-share cuda_ndt_matcher_launch)/config/cuda_scan_matcher.param.yaml"/>

  <!-- Topics (same interface as autoware_ndt_scan_matcher) -->
  <arg name="input_pointcloud" default="points_raw" description="Sensor points topic"/>
  <arg name="input_initial_pose_topic" default="ekf_pose_with_covariance" description="Initial position topic to align"/>
  <arg name="input_regularization_pose_topic" default="regularization_pose_with_covariance" description="Regularization pose topic"/>
  <arg name="input_service_trigger_node" default="trigger_node" description="Trigger node service name"/>
  <arg name="input_service_ndt_align" default="ndt_align_srv" description="NDT align service name"/>

  <arg name="output_pose_topic" default="pose" description="Estimated self position"/>
  <arg name="output_pose_with_covariance_topic" default="pose_with_covariance" description="Estimated self position with covariance"/>

  <arg name="client_map_loader" default="pcd_loader_service" description="Map loader service name"/>
  <arg name="input_pointcloud_map" default="/map/pointcloud_map" description="Pointcloud map topic"/>

  <arg name="node_name" default="ndt_scan_matcher" description="Use a different name for this node"/>

  <!-- Divergence detector 2: scan_matching_status latches ERROR when the median
       NVTL of the last divergence.nvtl_window_size scans falls below this.
       Per map and per input, so it is an argument rather than a value in
       param_file, and it overrides any value there. 0.0 disables. Write it as
       a float (2.5, not 2): the parameter is declared double. -->
  <arg name="divergence_nvtl_median_gate" default="0.0" description="Median-NVTL divergence gate; 0.0 disables"/>

  <node pkg="cuda_ndt_matcher" exec="cuda_ndt_matcher" name="$(var node_name)" output="both">
    <remap from="points_raw" to="$(var input_pointcloud)"/>
    <remap from="ekf_pose_with_covariance" to="$(var input_initial_pose_topic)"/>
    <remap from="regularization_pose_with_covariance" to="$(var input_regularization_pose_topic)"/>
    <remap from="trigger_node_srv" to="$(var input_service_trigger_node)"/>
    <remap from="ndt_align_srv" to="$(var input_service_ndt_align)"/>
    <remap from="pointcloud_map" to="$(var input_pointcloud_map)"/>

    <!-- Output topics use final names directly (rclrs doesn't support remapping) -->
    <!-- These are kept for documentation but don't remap since source = destination -->
    <remap from="pose" to="$(var output_pose_topic)"/>
    <remap from="pose_with_covariance" to="$(var output_pose_with_covariance_topic)"/>

    <remap from="pcd_loader_service" to="$(var client_map_loader)"/>

    <param from="$(var param_file)"/>
    <param name="divergence.nvtl_median_gate" value="$(var divergence_nvtl_median_gate)"/>
  </node>
</launch>
