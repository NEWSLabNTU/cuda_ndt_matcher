<launch>
  <!-- topic -->
  <arg name="output/pointcloud" default="downsample/pointcloud" description="final output topic name"/>

  <!-- container -->
  <arg name="localization_pointcloud_container_name" default="/pointcloud_container" description="container name of main lidar used for localization"/>

  <!-- whether use intra-process -->
  <arg name="use_intra_process" default="true" description="use ROS 2 component container communication"/>

  <!-- Which hardware runs this stage, whole-stage, the same shape as
       pointcloud_backend does for the sensing chain. The two halves are
       alternatives and cannot be mixed: the CUDA nodes exchange
       cuda_blackboard::CudaPointCloud2 and the CPU ones exchange PointCloud2.

       Note this only becomes GPU-resident end to end when the SENSING chain is
       also on CUDA (pointcloud_backend:=cuda), because that is what makes the
       concatenated cloud arrive on the blackboard. With a CPU sensing chain the
       nodes below still work — CudaBlackboardSubscriber falls back to a plain
       PointCloud2 subscription — but pay a host-to-device copy at the first
       stage.

       And they must live in the SAME container as the producer. cuda_blackboard
       is a process-local map keyed by an instance id published over ROS; a
       different process would receive the id and find nothing. -->
  <arg name="localization_pointcloud_backend" default="cpu" description="cpu or cuda"/>

  <!-- Which build of the CUDA crop box and random downsample to load. Autoware
       ships neither, so they come from cuda_pointcloud_filters
       (github.com/NEWSLabNTU/cuda_pointcloud_filters), which is what these
       default to.

       They are arguments rather than fixed names because this launch file is
       shared between projects, and a project that carries its own build of the
       same two filters must be able to point at it without editing a file it
       does not own. Naming one project's package here was exactly that mistake.

       The plugin namespace is separate from the package name because a fork is
       free to keep one and change the other. -->
  <arg name="cuda_filters_package" default="cuda_pointcloud_filters" description="package providing the CUDA crop box and random downsample"/>
  <arg name="cuda_filters_namespace" default="cuda_pointcloud_filters" description="C++ namespace of the plugins in cuda_filters_package"/>

  <!-- Both branches read the SAME parameter files, so the switch changes which
       hardware runs the stage and nothing else. The CUDA crop box declares the
       two extra keys the CPU component's file carries (output_frame, which it
       asserts rather than honours since it does not transform, and
       processing_time_threshold_sec, which it ignores) precisely so this is
       possible. Without that the switch would silently move the crop bounds and
       the point budget, which is how the first full-pipeline comparison came
       out meaningless. -->

  <group if="$(eval '\'$(var localization_pointcloud_backend)\' == \'cpu\'')">
    <load_composable_node target="$(var localization_pointcloud_container_name)">
      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::CropBoxFilterComponent" name="crop_box_filter_measurement_range">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/crop_box_filter_measurement_range_param_path)"/>
        <remap from="input" to="$(var input_pointcloud)"/>
        <remap from="output" to="measurement_range/pointcloud"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>

      <!-- localization_ prefix is load-bearing: see the note in
           tier4_localization_launch/launch/util/util.launch.xml. A component
           container silently drops a composable node whose base name is already
           registered, so perception's voxel_grid_downsample_filter would take
           this one's place and leave NDT with no points. -->
      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::VoxelGridDownsampleFilterComponent" name="localization_voxel_grid_downsample_filter">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/voxel_grid_downsample_filter_param_path)"/>
        <remap from="input" to="measurement_range/pointcloud"/>
        <remap from="output" to="voxel_grid_downsample/pointcloud"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>

      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::RandomDownsampleFilterComponent" name="random_downsample_filter">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/random_downsample_filter_param_path)"/>
        <remap from="input" to="voxel_grid_downsample/pointcloud"/>
        <remap from="output" to="$(var output/pointcloud)"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>
    </load_composable_node>
  </group>

  <group if="$(eval '\'$(var localization_pointcloud_backend)\' == \'cuda\'')">
    <load_composable_node target="$(var localization_pointcloud_container_name)">
      <!-- The CUDA nodes take their topics on private names, unlike the CPU
           components which use bare input/output. -->
      <composable_node pkg="$(var cuda_filters_package)" plugin="$(var cuda_filters_namespace)::CudaCropBoxFilterNode" name="crop_box_filter_measurement_range">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/crop_box_filter_measurement_range_param_path)"/>
        <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
        <remap from="~/output/pointcloud" to="measurement_range/pointcloud"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>

      <!-- Same name collision hazard as the CPU branch above, same prefix. -->
      <composable_node pkg="autoware_cuda_pointcloud_preprocessor" plugin="autoware::cuda_pointcloud_preprocessor::CudaVoxelGridDownsampleFilterNode" name="localization_voxel_grid_downsample_filter">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/voxel_grid_downsample_filter_param_path)"/>
        <remap from="~/input/pointcloud" to="measurement_range/pointcloud"/>
        <remap from="~/output/pointcloud" to="voxel_grid_downsample/pointcloud"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>

      <composable_node pkg="$(var cuda_filters_package)" plugin="$(var cuda_filters_namespace)::CudaRandomDownsampleFilterNode" name="random_downsample_filter">
        <param from="$(var ndt_scan_matcher/pointcloud_preprocessor/random_downsample_filter_param_path)"/>
        <remap from="~/input/pointcloud" to="voxel_grid_downsample/pointcloud"/>
        <remap from="~/output/pointcloud" to="$(var output/pointcloud)"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>
    </load_composable_node>
  </group>
</launch>
